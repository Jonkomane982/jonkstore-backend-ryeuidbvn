# Copy this file to .env for local development. In Render, set values in the
# service's Environment page. Never place real credentials in this file.
NODE_ENV=production
PORT=10000
HOST=0.0.0.0
API_PREFIX=/api
CORS_ORIGIN=https://your-frontend.example
OWNER_EMAIL=owner@example.com

# Required production dependencies. Intentionally blank.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY_BASE64=
FIREBASE_STORAGE_BUCKET=
DB_STORE_HOST=
DB_STORE_PORT=5432
DB_STORE_NAME=
DB_STORE_USER=
DB_STORE_PASSWORD=
DB_STORE_SSL=true
DB_AI_HOST=
DB_AI_PORT=5432
DB_AI_NAME=
DB_AI_USER=
DB_AI_PASSWORD=
DB_AI_SSL=true

# Optional services.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM_NAME=JonkStore
SMTP_FROM_EMAIL=
STORAGE_UPLOAD_DIR=/var/data/uploads
LOG_LEVEL=info
LOG_PRETTY=false
